{
  "name": "factory-asset-map-api",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker + D1 backend for Factory Asset Map",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute factory-asset-map --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute factory-asset-map --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true
  }
}
